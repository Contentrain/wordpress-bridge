{
    "name": "contentrain/wordpress-bridge",
    "description": "Development dependencies for Contentrain Bridge: coding-standards checks. Not part of the installed plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:all": "phpcs --standard=phpcs.xml.dist --ignore-annotations"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
